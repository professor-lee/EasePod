<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <queries><intent><action android:name="app.easepod.action.MUSIC_PLUGIN" /></intent></queries>
    <application>
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.plugin.files" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/plugin_file_paths" />
        </provider>
    </application>
</manifest>
